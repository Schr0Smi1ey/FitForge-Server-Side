# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# MongoDB Atlas credentials (the connection string is assembled in index.js)
DB_USER=
DB_PASS=

# Secret used to sign the JWTs issued by POST /jwt
ACCESS_TOKEN_SECRET=

# Stripe secret key. Use the sk_test_... key outside production.
STRIPE_SECRET_KEY=

# Signing secret for POST /webhook. Without it the webhook refuses every event,
# which means payments succeed at Stripe but no booking is ever recorded.
#
# Local dev: `stripe listen --forward-to localhost:5000/webhook` prints a
#   whsec_... value that is only valid for that listen session.
# Production: Stripe Dashboard > Developers > Webhooks > your endpoint >
#   "Signing secret". This is a DIFFERENT value from the CLI one.
STRIPE_WEBHOOK_SECRET=
